{
  "name": "ai-sdk-v7-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lsof -ti tcp:34001 | xargs kill -9 2>/dev/null; concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --env-file .env --import tsx/esm --watch src/backend/server.ts",
    "dev:web": "wait-on -t 30000 tcp:127.0.0.1:34001 && vite",
    "build": "vite build",
    "start": "node --env-file .env --import tsx/esm src/backend/server.ts",
    "eval": "niceeval",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/otel": "^1.0.152",
    "@ai-sdk/react": "^4.0.156",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "ai": "7.0.153",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "niceeval": "link:../../../..",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wait-on": "^9.5.1"
  }
}
