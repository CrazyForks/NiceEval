#!/usr/bin/env node
// External Incus CLI boundary: read-only discovery succeeds; allocation fails
// before creating any instance or volume. No real Incus daemon is contacted.
const args = process.argv.slice(2);
const method = args[args.indexOf("-X") + 1];
const path = new URL(args[args.indexOf("-X") + 2], "http://incus.invalid").pathname;
const emit = (metadata) => process.stdout.write(`${JSON.stringify({ type: "sync", status_code: 200, metadata })}\n`);
if (args[0] !== "query") throw new Error(`Unexpected Incus command: ${args[0]}`);
if (method !== "GET") {
  if (method !== "POST" || !path.endsWith("/volumes/custom")) {
    throw new Error(`Unexpected Incus mutation: ${method} ${path}`);
  }
  process.stdout.write(`${JSON.stringify({
    type: "error", error_code: 400,
    error: `PREFIX_ALLOCATION_FAILED ${"safe context ".repeat(160)} request req_prefix_capacity_123`,
  })}\n`);
} else if (path === "/1.0") emit({
  api_version: "1.0",
  environment: { certificate_fingerprint: "fixture-prefix-daemon", server_name: "fixture-prefix", server_pid: 1 },
});
else if (path.startsWith("/1.0/projects/")) emit({ name: path.split("/").at(-1) });
else if (path.endsWith("/resources")) emit({ space: { total: 1024 ** 4, used: 0 } });
else if (/^\/1\.0\/storage-pools\/[^/]+$/u.test(path)) {
  emit({ name: "niceeval-sandbox-dev", driver: "dir", config: { source: "/data/niceeval-sandbox-dev" } });
} else if (path === "/1.0/images") {
  emit([{
    fingerprint: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    aliases: [{ name: "niceeval/docker-execution-v1" }], type: "virtual-machine",
    properties: { "niceeval.guest-init": "block-docker-data/v1" },
  }]);
} else if (path === "/1.0/instances" || path.endsWith("/volumes/custom")) emit([]);
else process.stdout.write(`${JSON.stringify({ type: "error", error_code: 404, error: "not found" })}\n`);
